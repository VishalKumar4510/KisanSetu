# ==============================================================================
# KisanSetu Environment Variables Template
# Copy this file to .env before starting the application.
# NEVER commit .env files containing real secrets to Git.
# ==============================================================================

# Server Runtime Environment (development | staging | production | test)
NODE_ENV=development

# Backend API Port
PORT=3001

# Database URL (PostgreSQL + Prisma)
# Local development default:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/kisansetu?schema=public
# Docker compose development:
# DATABASE_URL=postgresql://postgres:postgrespassword_dev@postgres:5432/kisansetu?schema=public
# Production (AWS RDS / Neon / Supabase):
# DATABASE_URL=postgresql://user:secure_password@db-host.region.rds.amazonaws.com:5432/kisansetu?sslmode=require

# JSON Web Token Secret (MUST be at least 32 cryptographically secure random characters in production)
# Example generation: openssl rand -base64 32
JWT_SECRET=your-32-character-random-jwt-secret-here-replace-for-prod

# CORS Allowed Origins (Comma-separated URLs allowed to make API requests)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://localhost,http://127.0.0.1:5173

# Frontend Application URL (for link generation & CORS validation)
FRONTEND_URL=http://localhost:5173

# Demo Mode Isolation (true in dev/staging/SIH evaluation, false in production)
# When false: disables quick demo logins, skips demo seed accounts, protects endpoints
DEMO_MODE=true

# Structured Logging Level (fatal | error | warn | info | debug | trace)
LOG_LEVEL=info

# Rate Limiting Configuration (ms / max requests)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=30
RATE_LIMIT_MAX_GENERAL=600
