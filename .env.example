# ==============================================================================
# KisanSetu Environment Variables Template
# Copy this file to .env before starting the application.
# NEVER commit .env files containing real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Runtime Environment
# ------------------------------------------------------------------------------
# Allowed: development | staging | production | test
NODE_ENV=development

# Backend API Port
PORT=3001

# Structured Logging Level (fatal | error | warn | info | debug | trace)
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL + Prisma)
# ------------------------------------------------------------------------------
# Local development default (embedded or local PostgreSQL):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/kisansetu?schema=public

# Docker compose development:
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/kisansetu?schema=public

# Production example (AWS RDS / Neon / Supabase):
# DATABASE_URL=postgresql://db_user:secure_password_here@db-cluster.region.rds.amazonaws.com:5432/kisansetu?schema=public&sslmode=require

# Database Connection Pool Size (default: 10 in production, 1 in local test)
DATABASE_MAX_POOL=10

# Force TLS/SSL connection for managed cloud databases (true | false)
DATABASE_SSL=false

# In production, allow seeding demo accounts on empty database (default: false)
SEED_DEMO_DATA=false

# Safety override to permit database truncation in production (default: false)
ALLOW_PRODUCTION_TRUNCATE=false

# Override to allow localhost/127.0.0.1 DATABASE_URL when NODE_ENV=production
ALLOW_LOCAL_DB_IN_PRODUCTION=false

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
# JSON Web Token Secret (MUST be at least 32 cryptographically secure random characters in production)
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-at-least-32-random-characters-for-production!

# CORS Allowed Origins (Comma-separated URLs allowed to communicate with the API)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://localhost,http://127.0.0.1:5173

# Frontend Application Public URL (for link generation & CORS validation)
FRONTEND_URL=http://localhost:5173

# Demo Mode (true in dev/staging/SIH evaluation, false in strict production)
# When false: disables quick demo logins and enforces strict production rate limits
DEMO_MODE=true

# Rate Limiting Configuration (ms / max requests)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=30
RATE_LIMIT_MAX_GENERAL=600

# ------------------------------------------------------------------------------
# 4. Payment Subsystem & Banking Gateways (Phase 28)
# ------------------------------------------------------------------------------
# Active Payment Provider: 'sandbox' (simulated DBT) | 'production' (government gateway)
PAYMENT_PROVIDER=sandbox

# Webhook Cryptographic HMAC Secret for incoming callback verification
PAYMENT_WEBHOOK_SECRET=replace-with-secure-webhook-secret-min-32-chars

# Production PFMS/NPCI Gateway Configuration (when PAYMENT_PROVIDER=production)
# NOTE: In sandbox/demo mode, these remain unconfigured without breaking simulation
PFMS_API_ENDPOINT=
PFMS_CLIENT_ID=
PFMS_CLIENT_SECRET=
PFMS_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 5. Notification Subsystem (Phase 27)
# ------------------------------------------------------------------------------
# SMS Gateway Configuration (GovTech / CDAC / NIC SMS gateway)
# When empty, SMS adapter reports NOT_CONFIGURED without crashing or faking dispatch
SMS_GATEWAY_URL=
SMS_API_KEY=

# WhatsApp Business API Configuration
# When empty, WhatsApp adapter reports NOT_CONFIGURED
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# ------------------------------------------------------------------------------
# 6. Frontend Configuration (Optional)
# ------------------------------------------------------------------------------
# Optional API base URL override for frontend build (defaults to relative /api)
# VITE_API_URL=https://api.kisansetu.gov.in
