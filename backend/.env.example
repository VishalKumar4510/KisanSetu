NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/kisansetu?schema=public
JWT_SECRET=your-32-character-random-jwt-secret-here-replace-for-prod
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://localhost,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
DEMO_MODE=true
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=30
RATE_LIMIT_MAX_GENERAL=600
